# Server Configuration
PORT=3000
# Listen on all interfaces so phones on LAN can reach REST + Socket.IO (avoid 127.0.0.1-only)
HOST=0.0.0.0
NODE_ENV=development
# Base URL mobiles / émulateur utilisent pour joindre l’API (images temporaires style-transfer sans MinIO).
# Ex. Android emu: PUBLIC_API_BASE_URL=http://10.0.2.2:3000
#PUBLIC_API_BASE_URL=http://localhost:3000

# JWT Configuration
JWT_SECRET=your-super-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# Google Sign-In (OAuth 2.0 Web Client ID)
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# Database Configuration - MySQL
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=your_mysql_password
DB_DATABASE=visionart_db
DB_SYNCHRONIZE=true
DB_LOGGING=false
# SQL migrations (TypeORM): npm run migration:run  |  revert: npm run migration:revert

# Optional: Password reset email
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# MAIL_FROM=VisionArt <noreply@visionart.app>
FRONTEND_RESET_URL=http://localhost:3000/reset-password

# Stripe (https://dashboard.stripe.com)
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
STRIPE_PRO_PRICE_ID=price_REPLACE_ME
FRONTEND_SUCCESS_URL=visionart://subscription/success
FRONTEND_CANCEL_URL=visionart://subscription/cancel

# AI Content Moderation (OpenRouter — get key at openrouter.ai)
OPENROUTER_API_KEY=sk-or-REPLACE_ME

# Gemini (vision: sketch analysis, music vibe from image) — optional; set true to never call Gemini (saves quota when free tier is 0)
GEMINI_API_KEY=
# GEMINI_SKIP_VISION=true

# Hugging Face (image generation FLUX, img2img style-transfer)
HUGGINGFACE_API_KEY=

# POST /social/artworks/style-transfer:
# STYLE_TRANSFER_PROVIDER=auto|kie|bylo|huggingface|clipdrop
#   auto: KIE (Bylo-style Nano Banana Edit) → HF img2img → Clipdrop
#   kie / bylo: https://api.kie.ai only (same stack Bylo links to; needs PUBLIC_API_BASE_URL reachable from the internet)
KIE_API_KEY=
# KIE_API_BASE_URL=https://api.kie.ai
# KIE_NANO_BANANA_MODEL=google/nano-banana-edit

# HF img2img fallback / secondary path
# STYLE_TRANSFER_HF_MODEL=timbrooks/instruct-pix2pix

# Clipdrop: replace-background only (foreground often unchanged).
CLIPDROP_API_KEY=

# AI Music Generation
BEATOVEN_API_KEY=beatoven_REPLACE_ME
UDIOAPI_API_KEY=sk_REPLACE_ME

# Web3 / Marketplace (Polygon Amoy by default)
WEB3_RPC_URL=https://rpc-amoy.polygon.technology
WEB3_CHAIN_ID=80002
WEB3_CHAIN_NAME=Polygon Amoy
WEB3_NATIVE_SYMBOL=POL
WEB3_MARKETPLACE_CONTRACT_ADDRESS=
WEB3_NFT_CONTRACT_ADDRESS=
WEB3_USDC_CONTRACT_ADDRESS=
# Required for on-chain NFT minting and optional on-chain withdrawals
WEB3_TREASURY_PRIVATE_KEY=
WEB3_TREASURY_WALLET_ADDRESS=

# Storage (MinIO / S3-compatible)
MINIO_ENDPOINT=http://localhost:9000
MINIO_PUBLIC_BASE_URL=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=miniopassword
MINIO_BUCKET=visionart
MINIO_REGION=us-east-1
MINIO_FORCE_PATH_STYLE=true
MINIO_PRESIGN_EXPIRES_IN=900

# Real-time admin annonces: backoffice POST /announcements/notify uses x-announcement-broadcast-key (same value).
# In non-production, if unset, both apps use visionart-dev-announcement-broadcast.
ANNOUNCEMENT_BROADCAST_SECRET=visionart-dev-announcement-broadcast
