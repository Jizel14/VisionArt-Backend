# Server Configuration
PORT=3000
NODE_ENV=development

# JWT Configuration
JWT_SECRET=your-super-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# Google Sign-In (OAuth 2.0 Web Client ID)
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# Database Configuration - MySQL
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=your_mysql_password
DB_DATABASE=visionart_db
DB_SYNCHRONIZE=true
DB_LOGGING=false

# Optional: Password reset email
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# MAIL_FROM=VisionArt <noreply@visionart.app>
FRONTEND_RESET_URL=http://localhost:3000/reset-password

# Stripe (https://dashboard.stripe.com)
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME        # stripe listen --forward-to localhost:3000/webhooks/stripe
STRIPE_PRO_PRICE_ID=price_REPLACE_ME          # create a recurring price in Stripe dashboard
FRONTEND_SUCCESS_URL=visionart://subscription/success
FRONTEND_CANCEL_URL=visionart://subscription/cancel

# AI Content Moderation (OpenRouter — get key at openrouter.ai)
OPENROUTER_API_KEY=sk-or-REPLACE_ME
