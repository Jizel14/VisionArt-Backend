# Server Configuration
PORT=3000
NODE_ENV=development

# JWT Configuration
JWT_SECRET=your-super-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# Database Configuration - MySQL
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=your_mysql_password
DB_DATABASE=visionart_db
DB_SYNCHRONIZE=true
DB_LOGGING=false

# Web3 / Marketplace (Polygon Amoy by default)
WEB3_RPC_URL=https://rpc-amoy.polygon.technology
WEB3_CHAIN_ID=80002
WEB3_CHAIN_NAME=Polygon Amoy
WEB3_NATIVE_SYMBOL=POL
WEB3_MARKETPLACE_CONTRACT_ADDRESS=
WEB3_NFT_CONTRACT_ADDRESS=
WEB3_USDC_CONTRACT_ADDRESS=
WEB3_TREASURY_PRIVATE_KEY=
WEB3_TREASURY_WALLET_ADDRESS=